datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String   @id @default(cuid())
  username            String   @unique // "vandan" or "mitti"
  name                String   // "Vandan" or "Mitti"
  password            String
  profilePhoto        String?
  birthday            String?  // YYYY-MM-DD
  createdAt           DateTime @default(now())
  lastLogin           DateTime?
  onboardingCompleted Boolean  @default(false)
  wishesLocked        Boolean  @default(false)

  // Relationships
  wishesCreated       Wish[]   @relation("WishesCreated")
  wishesTargeted      Wish[]   @relation("WishesTargeted")
  fundTransactions    FundTransaction[]
  memoriesCreated     Memory[]
  lettersSent         LoveLetter[] @relation("LettersSent")
  lettersReceived     LoveLetter[] @relation("LettersReceived")
  surprisesCreated    Surprise[]   @relation("SurprisesCreated")
  surprisesReceived   Surprise[]   @relation("SurprisesReceived")
}

model CoupleSettings {
  id                   String   @id @default("couple")
  relationshipStartDate String  @default("2026-10-07") // YYYY-MM-DD
  level                Int      @default(1)
  xp                   Int      @default(0)
  currentStreak        Int      @default(0)
  bestStreak           Int      @default(0)
  lastStreakReset      DateTime?
  fundBalance          Int      @default(0)
  updatedAt            DateTime @updatedAt
}

model Wish {
  id           String    @id @default(cuid())
  order        Int       // 1 to 10
  title        String
  description  String
  category     String    // Love, Communication, Trust, Time, Emotional, Effort, Fun, Improvement
  createdById  String
  createdBy    User      @relation("WishesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User      @relation("WishesTargeted", fields: [targetUserId], references: [id], onDelete: Cascade)
  isLocked     Boolean   @default(false)
  status       String    @default("ACTIVE") // ACTIVE, IN_PROGRESS, COMPLETED, PERMANENTLY_ADOPTED
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ruleBreaks   FundTransaction[]
}

model FundTransaction {
  id        String   @id @default(cuid())
  type      String   // RULE_BREAK, SPENT, BONUS
  amount    Int      // 100 for rule break, or custom spent amount
  userId    String   // Who broke rule or who spent
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishId    String?
  wish      Wish?    @relation(fields: [wishId], references: [id], onDelete: SetNull)
  reason    String
  category  String?  // Date, Food, Movie, Gift, Outing, Birthday, Anniversary, Surprise
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model SpecialDate {
  id          String   @id @default(cuid())
  title       String
  date        String   // YYYY-MM-DD or MM-DD
  category    String   // BIRTHDAY, RELATIONSHIP, ANNIVERSARY, LOVE_DAY, FESTIVAL, CUSTOM
  emoji       String   @default("❤️")
  description String?
  isRecurring Boolean  @default(true)
  year        Int?
  createdAt   DateTime @default(now())
}

model Memory {
  id          String   @id @default(cuid())
  title       String
  date        String   // YYYY-MM-DD
  description String
  imageUrl    String?
  location    String?
  emoji       String?  @default("❤️")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model LoveLetter {
  id          String    @id @default(cuid())
  title       String    // e.g. "Open When You Miss Me"
  content     String
  senderId    String
  sender      User      @relation("LettersSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User      @relation("LettersReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  unlockDate  DateTime? // If scheduled/locked until date
  isRead      Boolean   @default(false)
  readAt      DateTime?
  reaction    String?   // emoji reaction
  createdAt   DateTime  @default(now())
}

model Surprise {
  id          String    @id @default(cuid())
  title       String
  type        String    // MESSAGE, PHOTO, LETTER, DATE_PLAN, GIFT_NOTE, VIDEO
  content     String
  creatorId   String
  creator     User      @relation("SurprisesCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User      @relation("SurprisesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  unlockDate  DateTime  // Locked until this exact timestamp
  isOpened    Boolean   @default(false)
  openedAt    DateTime?
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  // null means both users
  title     String
  message   String
  type      String   // ANNIVERSARY, BIRTHDAY, SURPRISE, WISH, FUND, STREAK
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
